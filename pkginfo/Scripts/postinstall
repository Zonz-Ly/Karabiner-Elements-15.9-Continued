#!/bin/sh

PATH=/bin:/sbin:/usr/bin:/usr/sbin
export PATH

#
# Create karabiner_machine_identifier
#

if [ ! -f '/Library/Application Support/org.pqrs/tmp/karabiner_machine_identifier.json' ]; then
    mkdir -p '/Library/Application Support/org.pqrs/tmp'
    chmod 0755 '/Library/Application Support/org.pqrs/tmp'

    echo "{\"karabiner_machine_identifier\": \"krbn-$(uuidgen | tr '[:upper:]' '[:lower:]')\"}" |
        tee '/Library/Application Support/org.pqrs/tmp/karabiner_machine_identifier.json'
    chmod 0644 '/Library/Application Support/org.pqrs/tmp/karabiner_machine_identifier.json'
fi

#
# Set suid
#

chmod 4755 '/Library/Application Support/org.pqrs/Karabiner-Elements/bin/karabiner_session_monitor'

# Local ad-hoc builds cannot reuse the official SMAppService parent identity.
# The package owns this root LaunchDaemon; signed Xcode builds retain SMAppService.
support='/Library/Application Support/org.pqrs/Karabiner-Elements'
core_info="$support/Karabiner-Core-Service.app/Contents/Info.plist"
local_build=$(/usr/libexec/PlistBuddy -c 'Print :KELocalBuild' "$core_info" 2>/dev/null || true)
if [ -n "$local_build" ]; then
    label='org.pqrs.service.daemon.Karabiner-Core-Service'
    helper="$support/Karabiner-Elements Privileged Daemons v2.app/Contents/MacOS/Karabiner-Elements Privileged Daemons v2"
    "$helper" unregister-legacy-core-daemon || exit 1
    source_plist="$support/Karabiner-Elements Privileged Daemons v2.app/Contents/Library/LaunchDaemons/$label.plist"
    target_plist="/Library/LaunchDaemons/$label.plist"
    plutil -lint "$source_plist" || exit 1
    install -o root -g wheel -m 644 "$source_plist" "$target_plist" || exit 1
    launchctl bootout "system/$label" 2>/dev/null || true
    launchctl bootstrap system "$target_plist" || exit 1
fi

#
# Relaunch karabiner processes
#

killall Karabiner-Core-Service
# karabiner_grabber is the former name of Karabiner-Core-Service.
killall karabiner_grabber
killall karabiner_session_monitor
killall karabiner_console_user_server
killall Karabiner-Menu
killall Karabiner-MultitouchExtension
killall Karabiner-NotificationWindow

#
# Update version file
#

cp \
    '/Library/Application Support/org.pqrs/Karabiner-Elements/package-version' \
    '/Library/Application Support/org.pqrs/Karabiner-Elements/version'

#
# Create a backup to allow recovery if the user manually deletes Karabiner-Elements without using the uninstaller
#

tar -C /Applications -cf '/Library/Application Support/org.pqrs/Karabiner-Elements/Karabiner-Elements.app.tar.gz' Karabiner-Elements.app

exit 0
